@model SchoolAppCoreMVC.Models.Student
@{
    ViewData["Title"] = "Student Details";
}

<h1>Details</h1>
<div>
    <h4>Student</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">LastName</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.LastName)</dd>
        <dt class="col-sm-3">FirstName</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.FirstName)</dd>
        <dt class="col-sm-3">EnrollmentDate</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.EnrollmentDate)</dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model.StudentID">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>
