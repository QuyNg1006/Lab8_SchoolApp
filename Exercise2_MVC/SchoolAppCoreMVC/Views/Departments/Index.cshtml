@model IEnumerable<SchoolAppCoreMVC.Models.Department>
@{
    ViewData["Title"] = "Departments";
}

<h1>Departments</h1>

<p><a asp-action="Create" class="btn btn-primary">Create New</a></p>
<table class="table">
    <thead>
        <tr>
                <th>DepartmentName</th>
                <th>Budget</th>
                <th>StartDate</th>
                <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
                <td>@Html.DisplayFor(m => item.DepartmentName)</td>
                <td>@Html.DisplayFor(m => item.Budget)</td>
                <td>@Html.DisplayFor(m => item.StartDate)</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.DepartmentID">Edit</a> |
                    <a asp-action="Details" asp-route-id="@item.DepartmentID">Details</a> |
                    <a asp-action="Delete" asp-route-id="@item.DepartmentID">Delete</a>
                </td>
        </tr>
}
    </tbody>
</table>
