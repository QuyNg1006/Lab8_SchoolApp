@model SchoolAppCoreMVC.Models.Instructor
@{
    ViewData["Title"] = "Delete Instructor";
}

<h1>Delete</h1>
<h3>Are you sure you want to delete this?</h3>
<div>
    <h4>Instructor</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">LastName</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.LastName)</dd>
        <dt class="col-sm-3">FirstName</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.FirstName)</dd>
        <dt class="col-sm-3">HireDate</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.HireDate)</dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="InstructorID" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-action="Index">Back to List</a>
    </form>
</div>
