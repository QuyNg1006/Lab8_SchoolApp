@page
@model SchoolAppCoreRazor.Pages.Enrollments.DetailsModel
@{
    ViewData["Title"] = "Enrollment Details";
}

<h1>Details</h1>
<div>
    <h4>Enrollment</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">Course</dt>
        <dd class="col-sm-9">@(Model.Item.Course?.Title)</dd>
        <dt class="col-sm-3">Student</dt>
        <dd class="col-sm-9">@(Model.Item.Student?.LastName + " " + Model.Item.Student?.FirstName)</dd>
        <dt class="col-sm-3">Grade</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.Item.Grade)</dd>
    </dl>
</div>
<div>
    <a asp-page="./Edit" asp-route-id="@Model.Item.EnrollmentID">Edit</a> |
    <a asp-page="./Index">Back to List</a>
</div>
