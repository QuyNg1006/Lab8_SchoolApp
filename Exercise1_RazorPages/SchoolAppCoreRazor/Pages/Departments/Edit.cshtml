@page
@model SchoolAppCoreRazor.Pages.Departments.EditModel
@{
    ViewData["Title"] = "Edit Department";
}

<h1>Edit</h1>
<h4>Department</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Item.DepartmentID" />
            <div class="mb-3">
                <label asp-for="Item.DepartmentName" class="form-label">DepartmentName</label>
                <input asp-for="Item.DepartmentName" class="form-control" />
                <span asp-validation-for="Item.DepartmentName" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Item.Budget" class="form-label">Budget</label>
                <input asp-for="Item.Budget" class="form-control" />
                <span asp-validation-for="Item.Budget" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Item.StartDate" class="form-label">StartDate</label>
                <input asp-for="Item.StartDate" class="form-control" />
                <span asp-validation-for="Item.StartDate" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>
<div>
    <a asp-page="./Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
